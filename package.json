{
  "name": "@zontafor/luxleaf-metal-mark",
  "version": "0.3.0-dev.0",
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "author": "Michelle L. Wu",
  "description": "Independent LuxLeaf conductor logo renderer with rounded relief, image intake, portable projects and exports.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "docs",
    "src",
    "demo",
    "tests",
    "scripts",
    "integrations",
    "tsconfig.json",
    "tsconfig.build.json",
    "vite.config.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zontafor/luxleaf-metal-mark.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
